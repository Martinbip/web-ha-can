# Copy this file to .env.e2e (gitignored) and fill in real values.
# .env.e2e is loaded by playwright.config.js and never committed.

# Base URL to test against. Defaults to https://smadesign.vn if unset.
# E2E_BASE_URL=https://smadesign.vn

# Admin credentials used only by tests/e2e/admin-*.spec.js.
# Tests that need these are skipped automatically if left unset.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
